{
  "name": "gridiron-dynasty",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Jeu de football américain 3D pour mobile (paysage) — Three.js + TypeScript",
  "scripts": {
    "dev": "vite --host --open /dev.html",
    "build": "tsc --noEmit && vite build && node scripts/pages.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
